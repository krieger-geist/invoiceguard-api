# Copy this file to .env and fill in real values before running docker-compose,
# or export these as real environment variables for a bare-metal/non-Docker run.
# Never commit a real .env file — it is already in .gitignore.

# ---- Database -----------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/invoiceguard
DB_USERNAME=invoiceguard
DB_PASSWORD=change-me
DB_NAME=invoiceguard
DB_PORT=5432

# ---- Redis ----------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- JWT ------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=

# ---- Bank account field encryption (AES-256, base64-encoded 32-byte key) --------
# Generate with: openssl rand -base64 32
BANK_ACCOUNT_ENCRYPTION_KEY=

# ---- AI integration (optional — the app works fully without this) ---------------
AI_INTEGRATION_ENABLED=false
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_MODEL=gemini-2.0-flash
AI_TIMEOUT_MS=8000

# ---- Documents --------------------------------------------------------------------
DOCUMENT_STORAGE_PATH=./data/documents
DOCUMENT_MAX_FILE_SIZE_MB=20

# ---- Security / auth ----------------------------------------------------------------
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Rate limiting --------------------------------------------------------------------
RATE_LIMIT_RPM=120

# ---- Risk engine thresholds (sane defaults shown; override only if you know why) ------
RISK_THRESHOLD_LOW_MAX=29
RISK_THRESHOLD_MEDIUM_MAX=59
RISK_THRESHOLD_HIGH_MAX=79
RISK_MIN_SAMPLE_SIZE=5
RISK_UNUSUAL_AMOUNT_Z_SCORE=2.5
RISK_HIGH_RISK_COUNTRIES=

# ---- Approval / webhooks -------------------------------------------------------------
APPROVAL_OVERDUE_HOURS=48
WEBHOOK_MAX_ATTEMPTS=6

# ---- Server -----------------------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
